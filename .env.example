# Copy to .env and adjust. Used by docker-compose.yml and bin/setup.sh (local development only).
WP_PORT=8080
SITE_URL=http://localhost:8080
DB_NAME=wordpress
DB_USER=wordpress
DB_PASSWORD=wordpress
DB_ROOT_PASSWORD=rootpass
ADMIN_USER=hara-admin
ADMIN_PASSWORD=change-me-locally
ADMIN_EMAIL=harafoodsltd@gmail.com
# Set to true when the machine has no internet, so WordPress doesn't stall on update checks.
HARA_BLOCK_EXTERNAL=false
